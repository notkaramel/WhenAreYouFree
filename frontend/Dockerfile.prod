# Build stage
FROM oven/bun:latest AS builder

WORKDIR /app

# Copy package files and lock file for faster installs
COPY package.json bun.lock* ./
# Install dependencies (Bun is much faster than npm)
RUN bun install

# Copy source code and build
COPY . .
RUN bun run build

# Production stage
FROM node:25-alpine AS production

WORKDIR /app

# Install nginx and openssl (for generating self-signed certs if needed)
RUN apk add --no-cache nginx openssl

# Copy built Nuxt app
COPY --from=builder /app/.output ./.output

# Copy nginx configuration
COPY nginx.conf /etc/nginx/http.d/default.conf

# Create SSL directory (certificates should be mounted as volume in production)
RUN mkdir -p /etc/nginx/ssl

# Copy startup script
COPY start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 80 443

CMD ["/start.sh"]